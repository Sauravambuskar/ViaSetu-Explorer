{
  "expo": {
    "name": "ViaSetu",
    "slug": "viasetu-production",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viasetu",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "duration": 5000
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.viasetu.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ViaSetu uses your camera so you can photograph and attach a package or issue image when booking a shipment or contacting support.",
        "NSLocationWhenInUseUsageDescription": "ViaSetu uses your location to auto-fill your pickup address and show accurate courier rates and delivery times for your area.",
        "NSPhotoLibraryUsageDescription": "ViaSetu accesses your photo library so you can attach an existing photo, such as a package or ID image, when booking a shipment or contacting support.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.viasetu.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "enableProguardInReleaseBuilds": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.viasetu.com"
        }
      ],
      "./plugins/with-arm64-only",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ViaSetu uses your location to auto-fill your pickup address and show accurate courier rates and delivery times for your area."
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9b8b7cb6-9d3a-46c2-8e99-c97748397242"
      }
    },
    "owner": "viasetu-pvt-ltd"
  }
}
